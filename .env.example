# Copy to .env and fill in what you need. Never commit .env.

# HuggingFace API token (for uploading artifacts; also used to download gated models)
# HF_TOKEN=hf_...

# Official Jev API (for distillation data generation and comparison)
# Get a key at https://openrouter.ai or https://console.typesafe.ai
# TYPESAFE_API_KEY=sk-...

# Decidex server settings (all optional; defaults shown)
# DECIDEX_MODEL=Qwen/Qwen3-4B
# DECIDEX_DEVICE=cuda:0
# DECIDEX_LORA=benchmarks/adapters/decidex-core-8b
# DECIDEX_API_KEY=
# DECIDEX_BASE_URL=http://127.0.0.1:8600
# DECIDEX_PREFIX_REUSE=1
# DECIDEX_PREFIX_CACHE_GB=4
# DECIDEX_MAX_QUEUE=8
# DECIDEX_MAX_INPUT_TOKENS=65536
# DECIDEX_MAX_BODY_BYTES=10485760
